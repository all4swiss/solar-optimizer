# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...
SOLAR_AGENT_ID=agent_011CaSxh4w2LmQc3wt4EB5HU

# Pre-created environment ID (run setup_environment.py once, then paste the ID here)
ANTHROPIC_ENVIRONMENT_ID=env_...

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://solar:solar_secret@db:5432/solaroptimizer
# For sync operations (alembic migrations)
SYNC_DATABASE_URL=postgresql+psycopg2://solar:solar_secret@db:5432/solaroptimizer

POSTGRES_USER=solar
POSTGRES_PASSWORD=solar_secret
POSTGRES_DB=solaroptimizer

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Home Assistant (per-user, stored in DB) ──────────────────────────────────
# These are stored per-user in the database; this is just documentation:
